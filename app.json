{
  "expo": {
    "name": "plan_ed",
    "slug": "plan_ed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/plan_ed-logo.jpg",
    "scheme": "planed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6CDAC",
        "foregroundImage": "./assets/images/plan_ed-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.geyzz.plan_ed"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/plan_ed-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D6CDAC",
          "image": "./assets/images/plan_ed-logo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5fd80b0-660a-4982-865d-f68ac26fc3f7"
      }
    }
  }
}
